
n = int(input("Enter number of objects: "))

weights = []
profits = []

print("Enter weights:")
for i in range(n):
    weights.append(int(input(f"Weight of object {i+1}: ")))

print("Enter profits:")
for i in range(n):
    profits.append(int(input(f"Profit of object {i+1}: ")))

capacity = int(input("Enter bag capacity: "))

# DP table
dp = [[0 for _ in range(capacity + 1)] for _ in range(n + 1)]

for i in range(1, n + 1):
    for w in range(1, capacity + 1):

        if weights[i - 1] <= w:
            dp[i][w] = max(
                profits[i - 1] + dp[i - 1][w - weights[i - 1]],
                dp[i - 1][w]
            )
        else:
            dp[i][w] = dp[i - 1][w]

print("\nMaximum Profit =", dp[n][capacity])

# Find selected objects
w = capacity
selected = []

for i in range(n, 0, -1):
    if dp[i][w] != dp[i - 1][w]:
        selected.append(i)
        w -= weights[i - 1]

selected.reverse()

print("Selected objects:", selected)

