v = int(input("Enter the number of vertices: "))

print("Enter the adjacency matrix (use 999 for infinity):")
dist = []

for i in range(v):
    row = list(map(int, input().split()))
    dist.append(row)

# Floyd-Warshall Algorithm
for k in range(v):
    for i in range(v):
        for j in range(v):
            dist[i][j] = min(dist[i][j],
                             dist[i][k] + dist[k][j])

print("Shortest distance matrix:")
for row in dist:
    print(*row)

