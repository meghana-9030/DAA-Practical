def kruskal(n, edges):
    parent = [i for i in range(n)]

    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]

    edges.sort(key=lambda x: x[2])

    cost = 0
    count = 0

    for u, v, w in edges:
        pu = find(u)
        pv = find(v)

        if pu != pv:
            parent[pu] = pv
            cost += w
            count += 1
            print(u, "-", v, ":", w)

        if count == n - 1:
            break

    if count == n - 1:
        print("Minimum Cost =", cost)
    else:
        print("MST is not possible")


n = int(input("Enter number of vertices: "))
e = int(input("Enter number of edges: "))

edges = []

for i in range(e):
    u, v, w = map(int, input("Enter source, destination and weight: ").split())
    edges.append((u, v, w))

kruskal(n, edges)

