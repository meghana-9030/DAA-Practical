#linear search
n = int(input("Enter the number of elements: "))

arr = []

for i in range(n):
    arr.append(int(input("Enter number: ")))

key = int(input("Enter the number to search: "))

found = False

for i in range(n):
    if arr[i] == key:
        print("Element found at position", i + 1)
        found = True
        break

if found == False:
    print("Element not found")
