def tsp(graph, n, curr, count, cost, visited):
    global min_cost

    if count == n and graph[curr][0] > 0:
        min_cost = min(min_cost, cost + graph[curr][0])
        return

    for i in range(n):
        if not visited[i] and graph[curr][i] > 0:
            visited[i] = True
            tsp(graph, n, i, count + 1,
                cost + graph[curr][i], visited)
            visited[i] = False


n = int(input("Enter number of cities: "))

graph = []

print("Enter cost matrix:")
for i in range(n):
    row = list(map(int, input().split()))
    graph.append(row)

min_cost = float('inf')
visited = [False] * n
visited[0] = True

tsp(graph, n, 0, 1, 0, visited)

if min_cost == float('inf'):
    print("Tour is not possible")
else:
    print("Minimum Cost =", min_cost)


