def matrix_chain(p, n):
    dp = [[0] * n for _ in range(n)]
    for length in range(2, n):
        for i in range(1, n - length + 1):
            j = i + length - 1
            dp[i][j] = float('inf')
            for k in range(i, j):
                cost = (dp[i][k] +
                        dp[k + 1][j] +
                        p[i - 1] * p[k] * p[j])

                dp[i][j] = min(dp[i][j], cost)
    return dp[1][n - 1]
n = int(input("Enter number of matrices: "))
p = list(map(int, input("Enter dimensions: ").split()))
answer = matrix_chain(p, n + 1)
print("Minimum number of multiplications =", answer)

